# ==== Environment Variables (Variáveis de Ambiente) ====
 
# This is a .env.example, copy it to .env and fill the values with your own credentials.
# Este é um arquivo .env.example, copie-o para .env e preencha os valores com suas próprias credenciais.

# ==== AI Variables (Variáveis da IA) ====

# You can choose the AI that you want to use, just remember to uncomment your API_KEY
# Você pode escolher a IA que deseja usar, só lembre-se de descomentar sua API_KEY

# (GEMINI) 
# AI_API_KEY=

# (GROQ)
# GROQ_API_KEY=

# ==== Evolution API Variables ====
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:YOURPASSWORD@postgres:5432/postgres?schema=public

# ==== Variável Postgre ====
DB_PASSWORD=YOURPASSWORD
PG_ADMIN_PASSWORD=
PG_ADMIN_EMAIL=you@admin.com

# ==== Redis ====
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution

WEBHOOK_GLOBAL_ENABLED=false
LOG_LEVEL=ERROR,WARN,INFO